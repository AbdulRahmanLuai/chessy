spring.application.name=chess-backend

# Database
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5433/chessy}
spring.datasource.username=${DB_USERNAME:your_db_username}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
logging.level.org.flywaydb=${FLYWAY_LOG_LEVEL:DEBUG}

# JWT
jwt.secret=${JWT_SECRET:replace-with-a-secure-secret-min-32-chars}
jwt.expiration=${JWT_EXPIRATION:900000}
jwt.refresh-expiration-days=${JWT_REFRESH_EXPIRATION_DAYS:30}

# OAuth2 Google
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:your-google-client-id}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:your-google-client-secret}
spring.security.oauth2.client.registration.google.scope=email,profile

# Application URLs
app.frontend-url=${FRONTEND_URL:http://localhost:5173}
app.frontend-redirect-url=${FRONTEND_REDIRECT_URL:http://localhost:5173/auth/callback}

# Logging
logging.level.org.springframework.security=${SECURITY_LOG_LEVEL:DEBUG}
logging.level.com.chessy=${APP_LOG_LEVEL:TRACE}
logging.level.com.corundumstudio.socketio=${SOCKETIO_LOG_LEVEL:TRACE}

# Jackson
spring.jackson.default-property-inclusion=always